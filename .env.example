APP_NAME="Fab Shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Set to "demo" to allow the demo:* Artisan commands to run - see CLAUDE.md.
APP_MODE=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# Content-Security-Policy on app pages: enforce | report-only | off (config/security.php)
CSP_MODE=enforce
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
# Browser connects via REVERB_HOST (localhost, port-forwarded by Docker);
# this app pushes events to Reverb server-to-server, which needs the
# Docker service name instead since Reverb now runs in its own container.
REVERB_INTERNAL_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Sandbox app credentials from https://developer.intuit.com - see CLAUDE.md.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI="${APP_URL}/quickbooks/callback"
QUICKBOOKS_ENVIRONMENT=sandbox

# Legal pages (/terms, /privacy, /sms-terms) - who the documents are from.
# Until these are set the pages show bracketed placeholders. See config/legal.php.
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_PRIVACY_EMAIL=
LEGAL_GOVERNING_LAW=
LEGAL_VENUE=
LEGAL_SMS_PROGRAM_NAME=
LEGAL_SMS_HELP_EMAIL=
LEGAL_SMS_HELP_PHONE=

# Quackback feedback widget (docs/context/feedback-widget.md). Leave both blank
# to run without it. The secret is server-only - never a VITE_* variable.
QUACKBACK_URL=
QUACKBACK_SIGNING_SECRET=

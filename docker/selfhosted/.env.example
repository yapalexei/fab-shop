# Fab Shop self-hosted settings. ./install.sh creates .env from this file and
# fills in every blank secret; edit .env afterwards (then `docker compose up -d`).

# --- Where people reach the shop ---------------------------------------------
# What Caddy listens for: ":80" (plain http, any hostname/IP) or a domain name
# (automatic https). APP_URL must be the address people actually type.
SITE_ADDRESS=:80
APP_URL=http://localhost
# Host ports Caddy publishes. Change HTTP_PORT if 80 is taken.
HTTP_PORT=80
HTTPS_PORT=443

# --- Application --------------------------------------------------------------
APP_NAME="Fab Shop"
APP_ENV=production
APP_DEBUG=false
APP_MODE=selfhosted
# KEEP A COPY: without this key the encrypted data (e.g. your AI key) and every
# backup of it are unreadable. install.sh generates it once.
APP_KEY=
# /setup answers 404 unless the link carries this - so nobody can claim the
# install between "it started" and "you created the owner". install.sh prints
# the full link; it stops mattering once the owner exists.
SELFHOSTED_SETUP_KEY=
LOG_CHANNEL=stderr
LOG_LEVEL=warning
# The marketing/public pages don't exist here, so there is nothing to render.
INERTIA_SSR_ENABLED=false
# Browsers reach the site over https only when SITE_ADDRESS is a domain.
# Set to true then so the session cookie is never sent over plain http.
SESSION_SECURE_COOKIE=false

# --- Database (inside the stack; not published) --------------------------------
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=fabshop
DB_USERNAME=fabshop
DB_PASSWORD=

# --- Queue, cache, sessions ---------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=database

# --- Files --------------------------------------------------------------------
FILESYSTEM_DISK=local

# --- Live job board (Reverb) --------------------------------------------------
# The browser connects to the site's own address (Caddy forwards /app/*), so
# there is no public host/port to configure - do NOT set REVERB_HOST/PORT/
# SCHEME here (they would be taken as a separate public address). The key is
# public by design; the secret never leaves the server.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_INTERNAL_HOST=reverb
REVERB_INTERNAL_PORT=8080
REVERB_INTERNAL_SCHEME=http

# --- Email ---------------------------------------------------------------------
# Team invitations and password resets are sent by email. "log" writes them to
# the container log instead (nothing is sent) - fine for trying it out, but
# invited people won't receive anything. For real use, point this at your mail
# provider (any SMTP service works):
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="shop@example.com"
MAIL_FROM_NAME="${APP_NAME}"
